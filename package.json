{
  "name": "yami",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A free, open-source desktop companion for Windows",
  "author": "Yami contributors",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "typecheck": "tsc --noEmit",
    "build": "npm run check:lines && npm run notices && npm run build:native && npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "node scripts/start.mjs",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "package": "npm run build && electron-builder --win portable",
    "preview:web": "node scripts/preview-web.mjs",
    "docs": "node scripts/build-docs.mjs",
    "check:lines": "node scripts/check-lines.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "check": "npm run check:lines && npm run check:ui && npm run check:biome && npm run check:secrets && npm run typecheck && npm run build:native && npm test",
    "notices": "node scripts/collect-notices.mjs",
    "lint": "biome lint",
    "format": "biome format --write",
    "check:biome": "biome ci",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run check",
    "lock:compact": "node -e \"const f=require('fs');f.writeFileSync('package-lock.json',JSON.stringify(JSON.parse(f.readFileSync('package-lock.json','utf8'))))\"",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "build": {
    "appId": "in.yami.desktop",
    "productName": "Yami",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "node_modules/pdfjs-dist/**/*"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native"
      },
      {
        "from": "public",
        "to": "assets",
        "filter": [
          "wallpapers/**/*",
          "cities.json",
          "yami-icon.png"
        ]
      },
      {
        "from": "docs/internal/assets/third-party",
        "to": "licenses"
      },
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "win": {
      "icon": "public/yami.ico",
      "target": "portable",
      "signExecutable": false
    },
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@ghostery/adblocker": "2.20.1",
    "@google/genai": "^2.30.0",
    "@m-lab/ndt7": "^0.1.5",
    "@phosphor-icons/web": "^2.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "^6.0.0",
    "jsqr": "^1.4.0",
    "motion": "^14.3.0",
    "node-pty": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "systeminformation": "^5.33.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "^44.8.0",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "marked": "^18.1.1",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sico-vibes/Yami.git"
  },
  "bugs": {
    "url": "https://github.com/sico-vibes/Yami/issues"
  },
  "homepage": "https://github.com/sico-vibes/Yami#readme"
}
